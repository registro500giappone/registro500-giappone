{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "env": {}
    },
    "supabase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref",
        "ttlttclfovuzafvghvaq"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "（Supabase個人アクセストークン: https://supabase.com/dashboard/account/tokens）"
      }
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "（GitHub Personal Access Token: https://github.com/settings/tokens）"
      }
    }
  }
}
