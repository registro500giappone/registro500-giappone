# HTMLファイルはキャッシュさせない（iOSホーム画面PWAで古いバージョンが使われるのを防ぐ）
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# manifest.jsonも毎回再取得
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# JSファイルもキャッシュさせない（コード更新がすぐ反映されるように）
/*.js
  Cache-Control: no-cache, no-store, must-revalidate
