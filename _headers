# Service Worker 本体は絶対にキャッシュさせない（新バージョン検知に必須）
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# HTMLファイルはキャッシュさせない（iOSホーム画面PWAで古いバージョンが使われるのを防ぐ）
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# manifest.jsonも毎回再取得
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# JSファイルもキャッシュさせない（コード更新がすぐ反映されるように）
/*.js
  Cache-Control: no-cache, no-store, must-revalidate

# CSSファイルもキャッシュさせない（デザイン更新がすぐ反映されるように）
/*.css
  Cache-Control: no-cache, no-store, must-revalidate

# 配線図の系統別画像は内容が変わらないので長期キャッシュ（2回目以降は再取得しない）
# ⚠️図を差し替えるときはファイル名を変えること（immutable のため上書きしても反映されない）
/wiring-img/*
  Cache-Control: public, max-age=31536000, immutable
