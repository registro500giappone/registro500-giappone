{
  "_comment": "トークンは書かない。値は環境変数 SUPABASE_ACCESS_TOKEN から展開する（${VAR}記法）。ローカル・クラウド両方で同じこのファイルが使われる。設定手順は CLAUDE.md「MCPサーバー構成」を参照。",
  "mcpServers": {
    "supabase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref",
        "ttlttclfovuzafvghvaq",
        "--read-only"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "env": {}
    }
  }
}
